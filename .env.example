# ── Ядро ────────────────────────────────────────────────────────────────
NFT_APP_ENV=dev
NFT_LOG_LEVEL=INFO
# JSON-логи для прод, читаемый консоль для дев
NFT_LOG_JSON=false

# ── HTTP-сервер (health endpoint) ───────────────────────────────────────
NFT_HTTP_HOST=0.0.0.0
NFT_HTTP_PORT=8080

# ── Инфраструктура (значения совпадают с docker-compose.yml) ────────────
NFT_POSTGRES_DSN=postgresql+asyncpg://nft_sniper:nft_sniper@localhost:5432/nft_sniper
NFT_REDIS_URL=redis://localhost:6379/0

# ── Telegram (заполнить на фазе) ───────────────────────────────
NFT_TELEGRAM_BOT_TOKEN=
NFT_DEFAULT_LANGUAGE=ru

# ── Внешние источники ─────────────────────────────────────
NFT_GETGEMS_API_KEY=
NFT_TONAPI_KEY=

# ── Дефолты алертов (переопределяются настройками пользователя) ─────────
NFT_DEFAULT_MIN_DISCOUNT=0.25
NFT_DEFAULT_MIN_CONFIDENCE=0.50
NFT_DEFAULT_MAX_ALERTS_PER_HOUR=20
# Цель по задержке от листинга до алерта, мс
NFT_ALERT_LATENCY_TARGET_MS=3000
